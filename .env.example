# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=agent_trace

# Server port
PORT=5000

# Admin secret — required to issue / list / revoke tokens at /api/v1/tokens.
# Change this in production. Treat it like a database password.
ADMIN_SECRET=change-me-in-production

# Optional signed-gateway auth. Set this only if a trusted control plane
# reverse-proxies traffic and signs requests with X-AgentTrace-* headers
# (HMAC-SHA256 over org\nuser\nproject\nsha256(body)). Leave UNSET to disable
# the gateway path and use bearer tokens only. Must match the gateway's secret.
# AGENT_TRACE_GATEWAY_SECRET=

# Maximum size of a single conversation blob accepted by POST /api/v1/blobs.
# Defaults to 10 MiB if unset.
BLOB_MAX_BYTES=10485760

# Optional: surfaced via /health and /api/v1/version. Set in CI to a git sha.
# BUILD_SHA=

# Set to "1" for Flask debug mode
FLASK_DEBUG=0
